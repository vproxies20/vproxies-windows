<Window x:Class="VProxies.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="VProxies" Width="1280" Height="830" MinWidth="1080" MinHeight="720"
  Background="{StaticResource PageBrush}" Foreground="#F4F8FF" WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Border Grid.Row="0" BorderBrush="#1C3048" BorderThickness="0,0,0,1" Padding="26,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="46" Height="46" CornerRadius="15" Background="{StaticResource BrandBrush}">
            <TextBlock Text="V" Foreground="#051018" FontSize="25" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="22" FontWeight="Bold"><Run Text="v"/><Run Text="proxies" Foreground="{StaticResource AccentBrush}"/></TextBlock>
            <TextBlock Text="Windows · sing-box + Wintun" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="0.9.3" Foreground="#7186A3" VerticalAlignment="Center" Margin="0,0,15,0"/>
          <Border x:Name="StatusBadge" Background="#2B3449" CornerRadius="18" Padding="15,8">
            <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#FF718B" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#FF9BA8" FontWeight="Bold"/></StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="20" Padding="19">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="VPROXIES ACCOUNT" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
            <TextBlock Text="Sign in to load your authorized proxies." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <TextBlock Text="Username or email" Foreground="#B4C2D5"/>
            <TextBox x:Name="IdentityBox" ToolTip="Username or email"/>
            <TextBlock Text="Password" Foreground="#B4C2D5" Margin="0,5,0,0"/>
            <PasswordBox x:Name="LoginPasswordBox" ToolTip="Account password"/>
            <Button x:Name="LoginButton" Content="Sign in &amp; load proxies" Style="{StaticResource PrimaryButton}" Click="Login_Click" Margin="0,8,0,4"/>
            <TextBlock x:Name="AccountStatusText" Text="Not signed in" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="1,7,0,0"/>
          </StackPanel>

          <Border Grid.Row="1" Height="1" Background="{StaticResource LineBrush}" Margin="0,18"/>

          <StackPanel Grid.Row="2">
            <TextBlock Text="ROUTING" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="12"/>
            <TextBlock Text="Traffic mode" Foreground="#B4C2D5" Margin="0,8,0,0"/>
            <ComboBox x:Name="ModeBox" SelectedIndex="0">
              <ComboBoxItem Content="Full system"/><ComboBoxItem Content="Rules only"/><ComboBoxItem Content="Selected applications"/>
            </ComboBox>
            <TextBlock Text="Applications (.exe, one per line)" Foreground="#B4C2D5" Margin="0,9,0,0"/>
            <TextBox x:Name="ApplicationsBox" Height="108" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="chrome.exe&#x0a;telegram.exe"/>
            <CheckBox x:Name="RemoteDnsBox" Content="DNS through proxy" IsChecked="True" Margin="0,12,0,2"/>
            <CheckBox x:Name="StrictRouteBox" Content="Prevent DNS leaks" IsChecked="True"/>
          </StackPanel>

          <TextBlock Grid.Row="3" Text="Only proxies authorized for your account are shown." Foreground="#657893" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </Grid>
      </Border>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="155"/></Grid.RowDefinitions>

        <TabControl Background="Transparent" BorderThickness="0">
          <TabItem Header="Gateway proxies">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="0,18,18,18" Padding="18">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Assigned proxy fleet" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Select a proxy and connect directly using its authorized source configuration." Foreground="{StaticResource MutedBrush}"/>
                  </StackPanel>
                  <Button Grid.Column="1" x:Name="RefreshGatewaysButton" Content="↻ Refresh" Click="RefreshGateways_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,17,0,13">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Gateway" Foreground="#B4C2D5"/>
                    <ComboBox x:Name="GatewayBox" DisplayMemberPath="DisplayName" SelectionChanged="GatewayBox_SelectionChanged"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Connection protocol" Foreground="#B4C2D5"/>
                    <ComboBox x:Name="GatewayProtocolBox" ToolTip="Protocols supported by the selected proxy"/>
                  </StackPanel>
                  <Border Grid.Column="4" Background="#0A2430" BorderBrush="#1E5260" BorderThickness="1" CornerRadius="10" Padding="12,7" Margin="0,5">
                    <StackPanel><TextBlock Text="DIRECT" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11"/><TextBlock Text="Device → source proxy" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel>
                  </Border>
                </Grid>

                <Border Grid.Row="2" Background="#081422" BorderBrush="#1C3048" BorderThickness="1" CornerRadius="13" Padding="1">
                  <DataGrid x:Name="ProxyGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ProxyGrid_SelectionChanged"
                    Background="#081422" Foreground="#EAF3FF" RowBackground="#0B1828" AlternatingRowBackground="#0E1D2E"
                    BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1A2B40"
                    HeadersVisibility="Column" CanUserAddRows="False" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="PROXY" Binding="{Binding DisplayName}" Width="2*"/>
                      <DataGridTextColumn Header="LOCATION" Binding="{Binding LocationText}" Width="1.4*"/>
                      <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Protocol}" Width="*"/>
                      <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="*"/>
                      <DataGridTextColumn Header="ENDPOINT" Binding="{Binding EndpointText}" Width="1.3*"/>
                      <DataGridTextColumn Header="LATENCY" Binding="{Binding LatencyText}" Width="*"/>
                    </DataGrid.Columns>
                  </DataGrid>
                </Border>

                <Grid Grid.Row="3" Margin="0,14,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock x:Name="ProxyCountText" Text="Sign in to load proxies" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="GatewayConnectButton" Content="Connect selected proxy" Style="{StaticResource PrimaryButton}" Click="GatewayConnect_Click" IsEnabled="False"/>
                    <Button Content="Disconnect" Style="{StaticResource DangerButton}" Click="Disconnect_Click"/>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </TabItem>

          <TabItem Header="Manual proxy">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="0,18,18,18" Padding="20">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                  <TextBlock Text="Manual connection" FontSize="24" FontWeight="SemiBold"/>
                  <TextBlock Text="Use a proxy you manage or are authorized to access." Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,18,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Protocol" Foreground="#B4C2D5"/><ComboBox x:Name="ProtocolBox" SelectedIndex="3"><ComboBoxItem Content="HTTP"/><ComboBoxItem Content="HTTPS"/><ComboBoxItem Content="SOCKS4"/><ComboBoxItem Content="SOCKS5"/></ComboBox>
                    <TextBlock Text="Host or IP" Foreground="#B4C2D5" Margin="0,8,0,0"/><TextBox x:Name="HostBox"/>
                    <TextBlock Text="Port" Foreground="#B4C2D5" Margin="0,8,0,0"/><TextBox x:Name="PortBox" Text="1080"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Proxy username" Foreground="#B4C2D5"/><TextBox x:Name="ProxyUsernameBox"/>
                    <TextBlock Text="Proxy password" Foreground="#B4C2D5" Margin="0,8,0,0"/><PasswordBox x:Name="ProxyPasswordBox"/>
                    <TextBlock Text="HTTPS SNI (optional)" Foreground="#B4C2D5" Margin="0,8,0,0"/><TextBox x:Name="SniBox"/>
                  </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button Content="Check proxy" Click="CheckProxy_Click"/>
                  <Button x:Name="ConnectButton" Content="Connect manual proxy" Style="{StaticResource PrimaryButton}" Click="Connect_Click"/>
                  <Button x:Name="DisconnectButton" Content="Disconnect" Style="{StaticResource DangerButton}" Click="Disconnect_Click" IsEnabled="False"/>
                </StackPanel>
              </Grid>
            </Border>
          </TabItem>
        </TabControl>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="15" Margin="0,14,0,0">
          <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Text="ACTIVITY LOG" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="11"/>
            <TextBox Grid.Row="1" x:Name="LogBox" Margin="0,8,0,0" Background="#071321" BorderThickness="0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
