<Window x:Class="VProxies.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="VProxies" Width="1480" Height="900" MinWidth="1220" MinHeight="760" Background="{StaticResource PageBrush}" Foreground="#F8FAFC" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#091322" BorderBrush="#1F314A" BorderThickness="0,0,0,1" Padding="20,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="assets/vproxies-logo.png" Width="52" Height="52"/><StackPanel Margin="13,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock Text="VProxies" Foreground="{StaticResource AccentBrush}" FontSize="24" FontWeight="Bold"/><Button x:Name="UpdateButton" Content="1.0.2" ToolTip="Check for updates" Click="CheckForUpdates_Click" Style="{StaticResource SmallButton}" Background="#41243B" BorderBrush="#633453" Foreground="#FF9BB5" Padding="8,3" Margin="9,3,0,2"/></StackPanel><TextBlock Text="Windows · sing-box 1.14 · Wintun" FontSize="11" Foreground="{StaticResource MutedBrush}"/></StackPanel></StackPanel>
        <Border Grid.Column="1" x:Name="StatusBadge" Background="#2B3449" CornerRadius="19" Padding="15,8" Margin="8,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#FF718B" Margin="0,0,8,0"/><StackPanel><TextBlock x:Name="StatusText" Text="Disconnected" Foreground="#FF9BA8" FontWeight="Bold"/><TextBlock x:Name="ConnectionDetailText" Text="No proxy is active" Foreground="#8295AE" FontSize="10"/></StackPanel></StackPanel></Border>
        <Button Grid.Column="2" x:Name="HeaderDisconnectButton" Content="■  DISCONNECT" Style="{StaticResource DangerButton}" Click="Disconnect_Click" IsEnabled="False" Padding="18,11"/>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="72"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource SidebarBrush}" BorderBrush="#1C2E46" BorderThickness="0,0,1,0"><Grid Margin="0,13"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Button x:Name="SidebarFleetButton" Content="&#xE8B7;" Tag="fleet" Style="{StaticResource SidebarNavButton}" ToolTip="Server fleet" Click="SidebarNavigation_Click" Background="#15324A" BorderBrush="{StaticResource AccentBrush}" Foreground="#EAFBFF"/><Button x:Name="SidebarAccountButton" Grid.Row="1" Content="&#xE77B;" Tag="account" Style="{StaticResource SidebarNavButton}" ToolTip="Account" Click="SidebarNavigation_Click"/><Button x:Name="SidebarRoutingButton" Grid.Row="2" Content="&#xE8F1;" Tag="routing" Style="{StaticResource SidebarNavButton}" ToolTip="Routing" Click="SidebarNavigation_Click"/><Button x:Name="SidebarActivityButton" Grid.Row="3" Content="&#xE9D9;" Tag="activity" Style="{StaticResource SidebarNavButton}" ToolTip="Activity log" Click="SidebarNavigation_Click"/><Button x:Name="SidebarSupportButton" Grid.Row="5" Content="&#xE897;" Tag="support" Style="{StaticResource SidebarNavButton}" ToolTip="Open VProxies support" Click="SidebarNavigation_Click"/></Grid></Border>
      <Grid Grid.Column="1" Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="278"/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="306"/></Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
          <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="VProxies Account" FontWeight="Bold" FontSize="13"/><TextBlock Text="Sign in to load your authorized proxies." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,13"/><TextBlock Text="Username or email" Foreground="#B8C8DC" FontSize="12"/><TextBox x:Name="IdentityBox"/><TextBlock Text="Password" Foreground="#B8C8DC" FontSize="12"/><PasswordBox x:Name="LoginPasswordBox"/><CheckBox x:Name="RememberAccountPasswordBox" Content="Remember password securely" ToolTip="Protected with Windows DPAPI for this Windows account"/><Button x:Name="LoginButton" Content="SIGN IN / LOAD PROXIES" Style="{StaticResource PrimaryButton}" Click="Login_Click" Margin="0,10,0,3"/><TextBlock x:Name="AccountStatusText" Text="Not signed in" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="1,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0"><StackPanel><TextBlock Text="ROUTING" FontWeight="Bold" FontSize="13"/><TextBlock Text="Traffic mode" Foreground="#B8C8DC" FontSize="12" Margin="0,13,0,0"/><ComboBox x:Name="ModeBox" SelectedIndex="0"><ComboBoxItem Content="Full system"/><ComboBoxItem Content="Rules only"/><ComboBoxItem Content="Selected applications"/></ComboBox><TextBlock Text="Applications (.exe, one per line)" Foreground="#B8C8DC" FontSize="12"/><TextBox x:Name="ApplicationsBox" Height="94" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/><CheckBox x:Name="RemoteDnsBox" Content="Private DNS through proxy" IsChecked="False" ToolTip="More private, but may be slower on some HTTPS or SOCKS5 proxies"/><CheckBox x:Name="StrictRouteBox" Content="Strict routing protection" IsChecked="True"/><TextBlock Text="Tip: keep Private DNS off for the fastest connection." Foreground="#6F839E" FontSize="10.5" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="168"/></Grid.RowDefinitions>
          <Border Style="{StaticResource CardStyle}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="18,17,18,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SERVER FLEET" FontSize="21" FontWeight="Bold"/><TextBlock Text="Select an authorized proxy and connect directly." Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><Button Grid.Column="1" x:Name="RefreshGatewaysButton" Content="↻  REFRESH" Style="{StaticResource GhostButton}" Click="RefreshGateways_Click"/></Grid>
            <Grid Grid.Row="1" Margin="18,13,18,12"><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Gateway" Foreground="#A9BAD0" FontSize="11"/><ComboBox x:Name="GatewayBox" DisplayMemberPath="DisplayName" SelectionChanged="GatewayBox_SelectionChanged"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Protocol" Foreground="#A9BAD0" FontSize="11"/><ComboBox x:Name="GatewayProtocolBox"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Search" Foreground="#A9BAD0" FontSize="11"/><TextBox x:Name="ProxySearchBox" TextChanged="ProxySearchBox_TextChanged"/></StackPanel></Grid>
            <DataGrid Grid.Row="2" x:Name="ProxyGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="ProxyGrid_SelectionChanged" Background="#0B1627" Foreground="#EAF3FF" RowBackground="#0D192A" AlternatingRowBackground="#101E31" BorderBrush="#243650" BorderThickness="0,1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1B2B42" HeadersVisibility="Column" CanUserAddRows="False" SelectionUnit="FullRow" RowHeight="46">
              <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17364C"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="SERVER" Width="1.45*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding CountryFlag}" FontSize="16" Margin="0,0,7,0"/><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding ProtocolListText}" FontSize="9.5" Foreground="#7086A2"/></StackPanel></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="LOCATION" Binding="{Binding LocationText}" Width="1.25*"/>
                <DataGridTemplateColumn Header="STATUS" Width=".75*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="State" Background="#4A5565" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" Foreground="White" FontSize="10" FontWeight="Bold"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsOnline}" Value="True"><Setter TargetName="State" Property="Background" Value="#16885E"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="PING" Width=".7*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="Ping" Background="#435167" CornerRadius="9" Padding="8,3" HorizontalAlignment="Left"><TextBlock Text="{Binding LatencyText}" Foreground="White" FontSize="10"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding LatencyBand}" Value="Fast"><Setter TargetName="Ping" Property="Background" Value="#147C59"/></DataTrigger><DataTrigger Binding="{Binding LatencyBand}" Value="Medium"><Setter TargetName="Ping" Property="Background" Value="#9C6B0C"/></DataTrigger><DataTrigger Binding="{Binding LatencyBand}" Value="Slow"><Setter TargetName="Ping" Property="Background" Value="#A5364E"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="ENDPOINT" Binding="{Binding EndpointText}" Width="1.05*"/>
                <DataGridTemplateColumn Header="ACTION" Width=".9*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="CONNECT" Style="{StaticResource SmallButton}" Background="#1E3855" Click="ProxyRowConnect_Click" CommandParameter="{Binding}" IsEnabled="{Binding IsOnline}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="3" Margin="14,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ProxyCountText" Text="Sign in to load proxies" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" FontSize="11"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="GatewayConnectButton" Content="▶  CONNECT SELECTED" Style="{StaticResource PrimaryButton}" Click="GatewayConnect_Click" IsEnabled="False"/><Button x:Name="GatewayDisconnectButton" Content="■  DISCONNECT" Style="{StaticResource DangerButton}" Click="Disconnect_Click" IsEnabled="False"/></StackPanel></Grid>
          </Grid></Border>
          <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="ACTIVITY LOG" FontWeight="Bold" FontSize="12"/><TextBlock x:Name="LogSummaryText" Text="  ·  Ready" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox x:Name="AutoScrollBox" Content="Auto-scroll" IsChecked="True" FontSize="10" Margin="4,0"/><Button Content="COPY" Style="{StaticResource SmallButton}" Click="CopyLog_Click"/><Button Content="CLEAR" Style="{StaticResource SmallButton}" Click="ClearLog_Click"/></StackPanel></Grid><RichTextBox Grid.Row="1" x:Name="LogBox" Margin="0,8,0,0" Background="#081321" BorderThickness="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10.5" Padding="8"><FlowDocument PagePadding="0"/></RichTextBox></Grid></Border>
        </Grid>
        <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="MANUAL CONNECTION" FontSize="18" FontWeight="Bold"/><TextBlock Text="Use a proxy you own or are authorized to access." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,13"/><TextBlock Text="Protocol" Foreground="#B8C8DC" FontSize="12"/><ComboBox x:Name="ProtocolBox" SelectedIndex="3"><ComboBoxItem Content="HTTP"/><ComboBoxItem Content="HTTPS"/><ComboBoxItem Content="SOCKS4"/><ComboBoxItem Content="SOCKS5"/></ComboBox><TextBlock Text="Host or IP" Foreground="#B8C8DC" FontSize="12"/><TextBox x:Name="HostBox"/><TextBlock Text="Port" Foreground="#B8C8DC" FontSize="12"/><TextBox x:Name="PortBox" Text="1080"/><TextBlock Text="Proxy username" Foreground="#B8C8DC" FontSize="12"/><TextBox x:Name="ProxyUsernameBox"/><TextBlock Text="Proxy password" Foreground="#B8C8DC" FontSize="12"/><PasswordBox x:Name="ProxyPasswordBox"/><CheckBox x:Name="RememberProxyPasswordBox" Content="Remember proxy password securely"/><TextBlock Text="HTTPS SNI (optional)" Foreground="#B8C8DC" FontSize="12" Margin="0,7,0,0"/><TextBox x:Name="SniBox"/><Button Content="CHECK PROXY" Style="{StaticResource GhostButton}" Click="CheckProxy_Click" Margin="0,8,0,2"/><Button x:Name="ConnectButton" Content="▶  CONNECT MANUALLY" Style="{StaticResource PrimaryButton}" Click="Connect_Click" Margin="0,5,0,2" Padding="15,11"/><Button x:Name="DisconnectButton" Content="■  DISCONNECT" Style="{StaticResource DangerButton}" Click="Disconnect_Click" IsEnabled="False" Margin="0,5,0,2" Padding="15,11"/><TextBlock Text="Credentials are never written to application logs." Foreground="#687D98" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
