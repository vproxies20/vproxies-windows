    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>VProxies</AssemblyName>
    <RootNamespace>VProxies</RootNamespace>
    <Version>0.9.1</Version>
    <Company>VProxies</Company>
    <Product>VProxies for Windows</Product>
    <ApplicationIcon>assets\vproxies.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
