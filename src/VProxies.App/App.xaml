<Application x:Class="VProxies.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#070D18"/><SolidColorBrush x:Key="SidebarBrush" Color="#0B1424"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#101B2E"/><SolidColorBrush x:Key="InputBrush" Color="#0B1627"/>
    <SolidColorBrush x:Key="LineBrush" Color="#243650"/><SolidColorBrush x:Key="AccentBrush" Color="#13E5FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8FA3BE"/><SolidColorBrush x:Key="SuccessBrush" Color="#22C985"/><SolidColorBrush x:Key="DangerBrush" Color="#E84B70"/>
    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#13E5FF"/><GradientStop Color="#087BFF" Offset=".52"/><GradientStop Color="#8B35FF" Offset="1"/></LinearGradientBrush>
    <Style x:Key="CardStyle" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="{StaticResource InputBrush}"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,5,0,8"/><Setter Property="SelectionBrush" Value="#355DB5"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="{StaticResource InputBrush}"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,5,0,8"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#EAF5FF"/><Setter Property="Foreground" Value="#07101D"/><Setter Property="BorderBrush" Value="#31516B"/><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,5,0,8"/></Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#243552"/><Setter Property="Foreground" Value="#F8FAFC"/><Setter Property="BorderBrush" Value="#365173"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value=".84"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".68"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#10CFE5"/><Setter Property="BorderBrush" Value="#53EFFF"/><Setter Property="Foreground" Value="#04131A"/></Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#B7244D"/><Setter Property="BorderBrush" Value="#F25C84"/></Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="#38516F"/><Setter Property="Foreground" Value="#C9D8EA"/></Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/><Setter Property="FontSize" Value="11"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C9D5E6"/><Setter Property="Margin" Value="0,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#16253B"/><Setter Property="Foreground" Value="#8EA4BF"/><Setter Property="BorderBrush" Value="#243650"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,11"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="9,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  </Application.Resources>
</Application>
