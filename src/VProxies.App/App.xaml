<Application x:Class="VProxies.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#07101D"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#0D1929"/>
    <SolidColorBrush x:Key="Panel2Brush" Color="#101F32"/>
    <SolidColorBrush x:Key="LineBrush" Color="#20324A"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#19D8E8"/>
    <SolidColorBrush x:Key="VioletBrush" Color="#9B72FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#91A2B9"/>
    <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#7EFFFF" Offset="0"/>
      <GradientStop Color="#19D8E8" Offset="0.35"/>
      <GradientStop Color="#6473FF" Offset="0.7"/>
      <GradientStop Color="#9B72FF" Offset="1"/>
    </LinearGradientBrush>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#071321"/><Setter Property="Foreground" Value="#F4F8FF"/><Setter Property="CaretBrush" Value="#19D8E8"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#071321"/><Setter Property="Foreground" Value="#F4F8FF"/><Setter Property="CaretBrush" Value="#19D8E8"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/><Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#EAF7FF"/><Setter Property="Foreground" Value="#07101D"/><Setter Property="BorderBrush" Value="#31516B"/>
      <Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#273759"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="15,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#19AFC4"/><Setter Property="Foreground" Value="#041118"/>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#4B2636"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#C9D5E6"/><Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#DCE8F8"/><Setter Property="Background" Value="#101F32"/><Setter Property="Padding" Value="18,9"/><Setter Property="Margin" Value="0,0,5,0"/>
    </Style>
  </Application.Resources>
</Application>
