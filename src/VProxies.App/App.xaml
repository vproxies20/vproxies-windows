<Application x:Class="VProxies.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#151C2F" />
    <SolidColorBrush x:Key="Panel2Brush" Color="#1C2640" />
    <SolidColorBrush x:Key="AccentBrush" Color="#57D3FF" />
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101729"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#31405F"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#101729"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#31405F"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#101729"/><Setter Property="Foreground" Value="#111827"/><Setter Property="BorderBrush" Value="#31405F"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0,5"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#273759"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
